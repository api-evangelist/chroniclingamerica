          "id": "a7ff8dda-8ad1-42eb-990e-70c9f9b2063c",
          "name": "Get a specific newspaper page",
          "request": {
            "name": "Get a specific newspaper page",
            "description": {
              "content": "Retrieve metadata for a specific page within a newspaper issue. Returns OCR text URL, image service URLs (IIIF), PDF download URL, JP2 image URL, and TIFF URL. Page sequence numbering starts at 1.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "titles",
                ":lccn",
                "issues",
                ":date",
                "ed-{{edition}}",
                "seq-{{sequence}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lccn",
                  "description": "(Required) Library of Congress Control Number (LCCN) for the newspaper title."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<date>",
                  "key": "date",
                  "description": "(Required) Publication date in YYYY-MM-DD format."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
