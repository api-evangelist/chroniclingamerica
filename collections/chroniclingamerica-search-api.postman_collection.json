          "name": "Search newspaper pages",
          "request": {
            "name": "Search newspaper pages",
            "description": {
              "content": "Full-text search across over 20 million historic American newspaper pages digitized under the National Digital Newspaper Program. Supports keyword search, date range filtering, state filtering, and newspaper title (LCCN) filtering. Responses are available in JSON or Atom format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search",
                "pages",
                "results",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "andtext",
                  "value": "<string>",
                  "description": "Words to search for (AND logic). All words must appear in the page."
                },
                {
                  "disabled": false,
                  "key": "phrasetext",
                  "value": "<string>",
                  "description": "Exact phrase to search for."
                },
                {
                  "disabled": false,
                  "key": "ortext",
                  "value": "<string>",
                  "description": "Words to search for (OR logic). Any word may appear in the page."
                },
                {
                  "disabled": false,
                  "key": "nottext",
                  "value": "<string>",
                  "description": "Words that must NOT appear in the page."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response format. Use json for JSON or atom for Atom feed."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Limit results to pages in a specific language."
                },
                {
                  "disabled": false,
                  "key": "lccn",
                  "value": "<string>",
                  "description": "Library of Congress Control Number (LCCN) of a specific newspaper title."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "US state name to filter results."
                },
                {
                  "disabled": false,
                  "key": "date1",
                  "value": "<string>",
                  "description": "Start date for search range (YYYY-MM-DD or YYYYMMDD)."
                },
                {
                  "disabled": false,
                  "key": "date2",
                  "value": "<string>",
                  "description": "End date for search range (YYYY-MM-DD or YYYYMMDD)."
                },
                {
                  "disabled": false,
                  "key": "dateFilterType",
                  "value": "<string>",
                  "description": "How to apply the date filter."
                },
                {
                  "disabled": false,
                  "key": "rows",
                  "value": "20",
